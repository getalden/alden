{
  "name": "alden",
  "version": "0.2.0",
  "description": "A code review companion: triages your PR queue and briefs you on what needs your eyes.",
  "keywords": [
    "code-review",
    "pull-requests",
    "github",
    "review-queue",
    "ai",
    "cli"
  ],
  "homepage": "https://getalden.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getalden/alden.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/getalden/alden/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "alden": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@napi-rs/keyring": "^2.1.0",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "commander": "^15.0.0",
    "ignore": "^7.0.10",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.0",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alden/core": "workspace:*",
    "@alden/schema": "workspace:*",
    "@alden/ui": "workspace:*",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "peerDependencies": {
    "@anthropic-ai/bedrock-sdk": ">=0.34",
    "@anthropic-ai/foundry-sdk": ">=0.5",
    "@anthropic-ai/vertex-sdk": ">=0.20"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    },
    "@anthropic-ai/vertex-sdk": {
      "optional": true
    },
    "@anthropic-ai/foundry-sdk": {
      "optional": true
    }
  }
}
