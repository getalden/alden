{
  "name": "alden",
  "version": "0.0.1",
  "description": "A code review companion: triages your PR queue and briefs you on what needs your eyes.",
  "keywords": [
    "code-review",
    "pull-requests",
    "github",
    "review-queue",
    "ai",
    "cli"
  ],
  "homepage": "https://getalden.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getalden/alden.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/getalden/alden/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "alden": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alden/core": "workspace:*",
    "@alden/schema": "workspace:*"
  }
}
