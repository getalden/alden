{
  "$id": "https://getalden.dev/schema/telemetry-event.v1.json",
  "title": "Alden telemetry event (only sent if you opt in)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "common": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "number",
          "const": 1
        },
        "app_version": {
          "type": "string"
        },
        "surface": {
          "type": "string",
          "enum": [
            "cli",
            "ui",
            "desktop",
            "mcp"
          ],
          "description": "where the event happened; mcp is an AI coding tool"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "node",
            "binary"
          ]
        },
        "os": {
          "type": "string",
          "enum": [
            "darwin",
            "linux",
            "win32",
            "other"
          ]
        },
        "arch": {
          "type": "string"
        },
        "install_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "days since this install first ran"
        }
      },
      "required": [
        "schema",
        "app_version",
        "surface",
        "runtime",
        "os",
        "arch",
        "install_age_days"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "telemetry_enabled"
            },
            "properties": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "command_run"
            },
            "properties": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "enum": [
                    "queue",
                    "open",
                    "review",
                    "ui",
                    "stats",
                    "feedback",
                    "memory",
                    "spend",
                    "config",
                    "auth",
                    "doctor",
                    "telemetry",
                    "mcp",
                    "comment",
                    "send",
                    "setup",
                    "interactive",
                    "ask",
                    "other"
                  ]
                },
                "ok": {
                  "type": "boolean"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "command",
                "ok",
                "duration_ms"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "queue_ranked"
            },
            "properties": {
              "type": "object",
              "properties": {
                "needs_you": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fast_track": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "dismissed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "repos": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "moved_by_learning": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "rows whose rank your feedback changed"
                }
              },
              "required": [
                "needs_you",
                "fast_track",
                "dismissed",
                "repos",
                "moved_by_learning"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "review_completed"
            },
            "properties": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "enum": [
                    "pr",
                    "local"
                  ]
                },
                "repo_hash": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "files": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "lines": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "code graph languages in the change, e.g. typescript, go"
                },
                "graph": {
                  "type": "boolean",
                  "description": "callers outside the diff were looked for"
                },
                "callers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checks_flagged": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "places to look shown"
                },
                "hidden_by_feedback": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "notes_used": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "llm_status": {
                  "type": "string",
                  "enum": [
                    "none",
                    "ok",
                    "refused",
                    "over_budget",
                    "failed",
                    "truncated",
                    "skipped"
                  ]
                },
                "model": {
                  "description": "the model id, e.g. claude-sonnet-5; null without one",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "target",
                "repo_hash",
                "files",
                "lines",
                "languages",
                "graph",
                "callers",
                "checks_flagged",
                "places",
                "hidden_by_feedback",
                "notes_used",
                "llm_status",
                "model",
                "usd",
                "duration_ms"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "feedback_given"
            },
            "properties": {
              "type": "object",
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "agree",
                    "not_needed",
                    "dismiss",
                    "clear"
                  ]
                },
                "placement": {
                  "type": "string",
                  "enum": [
                    "eyes",
                    "finding",
                    "check"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "check",
                    "llm"
                  ]
                },
                "check_id": {
                  "description": "Alden's own check id, e.g. tests.missing",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "verdict",
                "placement",
                "source",
                "check_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "missed_reported"
            },
            "properties": {
              "type": "object",
              "properties": {
                "has_place": {
                  "type": "boolean"
                }
              },
              "required": [
                "has_place"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "reaction_given"
            },
            "properties": {
              "type": "object",
              "properties": {
                "reaction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "dismiss",
                    "clear"
                  ]
                }
              },
              "required": [
                "reaction"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "pr_opened"
            },
            "properties": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 9007199254740991,
                  "description": "rank among PRs not opened lately; -1 in fast-track"
                }
              },
              "required": [
                "position"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "memory_changed"
            },
            "properties": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "add",
                    "edit",
                    "forget",
                    "restore",
                    "pause",
                    "resume",
                    "forget_all",
                    "exclude",
                    "include"
                  ]
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "draft_changed"
            },
            "properties": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "add",
                    "edit",
                    "discard",
                    "keep"
                  ],
                  "description": "keep: you kept one of Alden's drafts as it was, making it yours (editing one makes it yours too)"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "you",
                    "claude",
                    "alden"
                  ],
                  "description": "who wrote the draft: you, Claude Code drafting for you, or Alden drafting from a finding"
                },
                "inline": {
                  "type": "boolean",
                  "description": "on a line, rather than a general note"
                }
              },
              "required": [
                "action",
                "source",
                "inline"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "draft_assisted"
            },
            "properties": {
              "type": "object",
              "properties": {
                "reply": {
                  "type": "boolean",
                  "description": "a reply in a review thread, rather than a comment"
                },
                "inline": {
                  "type": "boolean",
                  "description": "on a line, rather than a general note or a reply"
                },
                "edited": {
                  "type": "boolean",
                  "description": "you changed Alden's text before saving it"
                }
              },
              "required": [
                "reply",
                "inline",
                "edited"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "review_sent"
            },
            "properties": {
              "type": "object",
              "properties": {
                "review": {
                  "type": "string",
                  "enum": [
                    "comment",
                    "approve",
                    "request_changes"
                  ]
                },
                "inline": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "comments on lines"
                },
                "notes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "general notes, sent in the review's body"
                },
                "from_you": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "from_claude": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "drafted by Claude Code, then sent by you"
                },
                "has_body": {
                  "type": "boolean",
                  "description": "you wrote a review body"
                },
                "unaddressed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "places Alden flagged that the review didn't comment near"
                }
              },
              "required": [
                "review",
                "inline",
                "notes",
                "from_you",
                "from_claude",
                "has_body",
                "unaddressed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "review_signals"
            },
            "properties": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "review",
                    "outcome"
                  ],
                  "description": "a review you sent, or what the author did with it afterwards"
                },
                "request_changes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "suggestion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "comment": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "silent_pass": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "places you were shown and approved without a comment"
                },
                "miss": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "comments where Alden had flagged nothing"
                },
                "applied": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "resolved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "source",
                "request_changes",
                "suggestion",
                "comment",
                "silent_pass",
                "miss",
                "applied",
                "resolved"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "review_timed"
            },
            "properties": {
              "type": "object",
              "properties": {
                "active_minutes": {
                  "type": "string",
                  "enum": [
                    "0-2",
                    "2-5",
                    "5-10",
                    "10-20",
                    "20-30",
                    "30-60",
                    "60+"
                  ],
                  "description": "active time on the review, as a bucket of minutes"
                },
                "wall_time": {
                  "type": "string",
                  "enum": [
                    "0-15m",
                    "15-60m",
                    "1-4h",
                    "4-24h",
                    "1-3d",
                    "3d+"
                  ],
                  "description": "first opening the briefing to sending, as a bucket"
                },
                "measured": {
                  "type": "boolean",
                  "description": "active time measured in the UI; false: from a terminal or AI tool, briefing to send, capped"
                },
                "places_seen": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "places Alden flagged that were in front of you"
                },
                "comments": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "comments and replies sent"
                },
                "model": {
                  "type": "boolean",
                  "description": "Alden's model briefed or drafted during the review"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "comment",
                    "approve",
                    "request_changes"
                  ]
                }
              },
              "required": [
                "active_minutes",
                "wall_time",
                "measured",
                "places_seen",
                "comments",
                "model",
                "verdict"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "tone_set"
            },
            "properties": {
              "type": "object",
              "properties": {
                "tone": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "terse",
                        "concise",
                        "detailed",
                        "teaching"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "null: a repo's own tone removed"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "repo",
                    "default"
                  ],
                  "description": "one repo's tone on this machine, or the global drafts.tone"
                }
              },
              "required": [
                "tone",
                "scope"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "question_asked"
            },
            "properties": {
              "type": "object",
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "answered",
                    "refused",
                    "cancelled",
                    "failed"
                  ],
                  "description": "refused: Alden didn't ask (no model, no briefing, text aimed at AI reviewers, over budget)"
                },
                "cost": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "unpriced",
                        "0-0.01",
                        "0.01-0.05",
                        "0.05-0.25",
                        "0.25+"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "what the call cost, as a bucket; null when no call was made or a failed one's cost isn't known"
                },
                "follow_up": {
                  "type": "boolean",
                  "description": "earlier questions on the same PR were sent along"
                }
              },
              "required": [
                "outcome",
                "cost",
                "follow_up"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "stats_viewed"
            },
            "properties": {
              "type": "object",
              "properties": {
                "repo_hash": {
                  "type": "string"
                },
                "prs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "split": {
                  "type": "boolean",
                  "description": "there's a before and after"
                },
                "first_review_before_h": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "first_review_after_h": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cycle_before_h": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cycle_after_h": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "repo_hash",
                "prs",
                "split",
                "first_review_before_h",
                "first_review_after_h",
                "cycle_before_h",
                "cycle_after_h"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "properties"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "common",
    "event"
  ],
  "additionalProperties": false
}
