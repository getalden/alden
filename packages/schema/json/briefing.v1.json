{
  "$id": "https://getalden.dev/schema/briefing.v1.json",
  "title": "Alden briefing",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pr"
            },
            "repo": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string"
            },
            "author": {
              "type": [
                "string",
                "null"
              ]
            },
            "baseRef": {
              "type": "string"
            },
            "headRef": {
              "type": "string"
            },
            "headSha": {
              "description": "the PR head commit briefed; absent in briefings from before Alden 0.5",
              "type": "string"
            },
            "baseSha": {
              "description": "the base commit the code graph saw (the merge's first parent); absent when it came from the PR's branch",
              "type": "string"
            },
            "graphFrom": {
              "description": "where callers came from: GitHub's merge of the PR onto its latest base, or the PR's own branch (it conflicts, or GitHub hasn't merged it yet); absent when the graph didn't run",
              "type": "string",
              "enum": [
                "merge",
                "head"
              ]
            }
          },
          "required": [
            "kind",
            "repo",
            "number",
            "url",
            "title",
            "author",
            "baseRef",
            "headRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "repoRoot": {
              "type": "string"
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "repoRoot",
            "branch"
          ],
          "additionalProperties": false
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "additions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "deletions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reviewableAdditions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "additions outside lockfiles"
        },
        "reviewableDeletions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "deletions outside lockfiles"
        }
      },
      "required": [
        "files",
        "additions",
        "deletions",
        "reviewableAdditions",
        "reviewableDeletions"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "previousPath": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "removed",
              "renamed"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "docs",
              "test",
              "dependency",
              "code",
              "other"
            ]
          },
          "additions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "deletions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "binary": {
            "type": "boolean"
          },
          "patchMissing": {
            "type": "boolean",
            "description": "the file changed but its diff was too large to fetch"
          }
        },
        "required": [
          "path",
          "status",
          "kind",
          "additions",
          "deletions",
          "binary",
          "patchMissing"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "stable identifier, e.g. tests.missing"
          },
          "title": {
            "type": "string",
            "description": "what the check looks for, e.g. Code changed without tests"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "flagged",
              "skipped"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "how much a flag matters; info for passed and skipped checks"
          },
          "summary": {
            "type": "string",
            "description": "the result in one sentence"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "what Alden looked at or found, in one line"
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "description": "line in the new file; absent for whole-file findings",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          },
          "heuristic": {
            "type": "boolean",
            "description": "true when the check infers from the diff alone and may be wrong"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "severity",
          "summary",
          "evidence",
          "heuristic"
        ],
        "additionalProperties": false
      }
    },
    "needsYourEyes": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "why a human should look, in one sentence"
          },
          "anchor": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "description": "line in the new file; absent for whole-file findings",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "checkId": {
            "description": "the check that raised it, if any",
            "type": "string"
          },
          "source": {
            "description": "a deterministic check or the model; absent means check",
            "type": "string",
            "enum": [
              "check",
              "llm"
            ]
          },
          "learned": {
            "description": "why your feedback put it here, e.g. 'you usually mark migration flags useful'",
            "type": "string"
          }
        },
        "required": [
          "title",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "the places to look first, `review.eyes` of them at most"
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what Alden did not check, stated plainly"
    },
    "llm": {
      "description": "the model's view; absent when no model was asked",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "refused",
            "over_budget",
            "failed",
            "truncated",
            "skipped"
          ],
          "description": "ok, or why there is no model section"
        },
        "note": {
          "description": "one line explaining a status other than ok",
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "description": "the effort level sent, when one was",
          "type": "string"
        },
        "summary": {
          "description": "what the change does, in plain words",
          "type": "string"
        },
        "matchesTitle": {
          "description": "whether the change does what its title and description say",
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "yes",
                "partly",
                "no",
                "unclear"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "checkId": {
                "description": "the check whose topic the model tagged it with (e.g. tests.missing), so feedback on it teaches that lesson",
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "what's wrong or worth checking, and why, in one or two sentences"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "description": "line in the new file; absent for whole-file findings",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "detail",
              "severity",
              "anchors"
            ],
            "additionalProperties": false
          }
        },
        "droppedFindings": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "findings discarded for pointing at lines not in the diff"
        },
        "omittedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "files left out of the model's view to fit the budget"
        },
        "redactedSecrets": {
          "description": "likely secrets replaced with placeholders before the prompt was sent",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "description": "what the call cost at list price, when known",
          "type": "number"
        }
      },
      "required": [
        "status",
        "findings",
        "droppedFindings",
        "omittedFiles"
      ],
      "additionalProperties": false
    },
    "learning": {
      "description": "what your feedback and memory changed; absent when nothing",
      "type": "object",
      "properties": {
        "hidden": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "line": {
                    "description": "line in the new file; absent for whole-file findings",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title",
              "reason"
            ],
            "additionalProperties": false
          },
          "description": "places that would have been picked, left out because of your feedback"
        },
        "quietened": {
          "description": "flagged checks your feedback quietened: still run and listed, but left out of the places to look, e.g. 'quietened by your feedback: you usually mark untested-change flags not useful (3 of 3)'",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checkId": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "checkId",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "memory": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "notes about you that were given to the model"
        }
      },
      "required": [
        "hidden",
        "memory"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "target",
    "generatedAt",
    "summary",
    "files",
    "checks",
    "needsYourEyes",
    "notChecked"
  ],
  "additionalProperties": false
}
