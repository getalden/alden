            "additionalProperties": false
          },
          "lane": {
            "type": "string",
            "enum": ["needs-you", "fast-track"]
          },
          "fastTrack": {
            "description": "why it qualified for fast-track; only set in that lane",
            "type": "string",
            "enum": ["docs only", "tests only", "dependency patch bump"]
          },
          "score": {
            "type": "object",
            "properties": {
              "risk": {
                "type": "number"
              },
              "wait": {
                "type": "number"
              },
              "blocking": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "required": ["risk", "wait", "blocking", "total"],
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "short human reasons, heaviest first"
          },
          "waitingHours": {
            "type": "number",
            "description": "hours since the viewer was asked, or since the PR opened"
          },
          "waitingOnAuthor": {
            "type": "boolean",
            "description": "CI is failing, so the author has to act before a review is worth it"
          }
        },
        "required": ["pr", "lane", "score", "reasons", "waitingHours", "waitingOnAuthor"],
