                ]
              },
              "reviews": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "author": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "state": {
                      "type": "string"
                    },
                    "submittedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "author",
                    "state",
                    "submittedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "request": {
                "type": "object",
                "properties": {
                  "direct": {
                    "type": "boolean",
                    "description": "the viewer was asked by name"
                  },
                  "teams": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "the viewer's teams that were asked, as org/slug"
                  },
                  "requestedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "when the viewer or one of their teams was most recently asked"
                  }
                },
                "required": [
                  "direct",
                  "teams",
                  "requestedAt"
                ],
                "additionalProperties": false
              },
              "codeownedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "changed files the viewer owns through CODEOWNERS"
              },
              "stackedPrs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "open PRs built on top of this one"
              },
              "majorBumps": {
                "description": "dependencies the PR's manifest changes move up a major version (or a 0.x minor one)",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "the package, as its manifest names it"
                    },
                    "from": {
                      "type": "string",
                      "description": "the major version before, e.g. \"3\", or \"0.2\" for a 0.x version"
                    },
                    "to": {
                      "type": "string",
                      "description": "the major version after"
                    }
                  },
                  "required": [
                    "name",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "repo",
              "number",
              "title",
              "url",
              "author",
              "authorIsBot",
              "isDraft",
              "createdAt",
              "updatedAt",
              "baseRef",
              "headRef",
              "additions",
              "deletions",
              "changedFiles",
              "files",
              "filesTruncated",
              "labels",
              "ci",
              "mergeable",
              "reviews",
              "request",
              "codeownedFiles",
              "stackedPrs"
            ],
            "additionalProperties": false
          },
          "lane": {
            "type": "string",
            "enum": [
              "needs-you",
              "fast-track"
            ]
          },
          "fastTrack": {
            "description": "why it qualified for fast-track; only set in that lane",
            "type": "string",
            "enum": [
              "docs only",
              "tests only",
              "dependency patch bump"
            ]
          },
          "score": {
            "type": "object",
            "properties": {
              "risk": {
                "type": "number"
              },
              "wait": {
                "type": "number"
              },
              "blocking": {
                "type": "number"
              },
              "learned": {
                "description": "points added because you usually open PRs like this first",
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "required": [
              "risk",
              "wait",
              "blocking",
              "total"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "short human reasons, heaviest first"
          },
          "waitingHours": {
            "type": "number",
            "description": "hours since the viewer was asked, or since the PR opened"
          },
          "waitingOnAuthor": {
            "type": "boolean",
            "description": "CI is failing, so the author has to act before a review is worth it"
          }
        },
        "required": [
          "pr",
          "lane",
          "score",
          "reasons",
          "waitingHours",
          "waitingOnAuthor"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "viewer",
    "fetchedAt",
    "needsYou",
    "fastTrack",
    "warnings"
  ],
  "additionalProperties": false
}
