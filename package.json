{
  "name": "alden-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter alden dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "eval": "tsx scripts/eval.ts",
    "ui:demo": "tsx scripts/ui-demo.ts",
    "regressions:find": "tsx scripts/find-regressions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "picomatch": "^4.0.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
