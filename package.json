{
  "name": "alden-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter alden dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release:version": "changeset version && tsx scripts/sync-desktop-version.ts && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "eval": "tsx scripts/eval.ts",
    "ui:demo": "tsx scripts/ui-demo.ts",
    "regressions:find": "tsx scripts/find-regressions.ts",
    "build:binary": "tsx scripts/build-binary.ts",
    "smoke:binary": "tsx scripts/smoke-binary.ts",
    "homebrew:formula": "tsx scripts/homebrew-formula.ts",
    "release:dry-run": "tsx scripts/release-dry-run.ts",
    "desktop:sidecar": "tsx scripts/desktop-sidecar.ts",
    "desktop:dev": "pnpm --filter @alden/desktop app:dev",
    "desktop:build": "pnpm build && pnpm build:binary && pnpm desktop:sidecar && pnpm --filter @alden/desktop app:build",
    "screenshots": "tsx scripts/screenshots.ts",
    "site:build": "tsx site/build.ts",
    "site:deploy": "pnpm site:build && cd site && pnpm dlx wrangler@4 pages deploy dist --project-name getalden --branch main"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "bun": "^1.4.2",
    "marked": "^18.0.14",
    "picomatch": "^4.0.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
